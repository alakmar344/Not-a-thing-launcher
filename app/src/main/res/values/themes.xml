<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NothingLauncher" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/nothing_white</item>
        <item name="colorPrimaryVariant">@color/text_secondary</item>
        <item name="colorOnPrimary">@color/nothing_black</item>
        <item name="colorSecondary">@color/nothing_red</item>
        <item name="colorSecondaryVariant">@color/nothing_red</item>
        <item name="colorOnSecondary">@color/nothing_white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/nothing_white</item>
        <item name="colorControlHighlight">@color/ripple_light</item>
        <item name="android:colorBackground">@color/nothing_black</item>
        <item name="android:windowBackground">@color/nothing_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <!-- Lets the window composite over the system wallpaper; MainActivity turns this
             off (and makes the surface opaque) for the dot-grid and black backgrounds. -->
        <item name="android:windowShowWallpaper">true</item>
    </style>

    <style name="Theme.NothingLauncher.Settings">
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- Floating sheets & dialogs: we draw our own card, the window stays transparent. -->
    <style name="Theme.NothingLauncher.Sheet" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@style/Animation.NothingLauncher.Sheet</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlActivated">@color/nothing_white</item>
        <item name="colorControlHighlight">@color/ripple_light</item>
    </style>

    <style name="Animation.NothingLauncher.Sheet" parent="">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>

    <style name="Animation.NothingLauncher.Popup" parent="">
        <item name="android:windowEnterAnimation">@anim/popup_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_exit</item>
    </style>
</resources>
