    </style>

    <!--
        Used by NothingLauncher whenever the backdrop is our own (dot grid or black) instead of
        the wallpaper: text colours follow the backdrop, not the hidden wallpaper.
    -->
    <style name="NtTheme.Backdrop.Light" parent="@style/AppTheme.DarkText">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@color/nothing_bg</item>
        <item name="workspaceTextColor">@color/text_primary</item>
    </style>

    <style name="NtTheme.Backdrop.Dark" parent="@style/AppTheme.Dark">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@color/nothing_bg</item>
        <item name="workspaceTextColor">@color/text_primary</item>
        <item name="workspaceShadowColor">@android:color/transparent</item>
        <item name="workspaceAmbientShadowColor">@android:color/transparent</item>
        <item name="workspaceKeyShadowColor">@android:color/transparent</item>
    </style>

    <!-- v10 settings screen. -->
    <style name="Theme.NothingLauncher.Settings">
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- Icon labels, folder titles and headlines use the v10 typeface. -->
    <style name="BaseIconRoot" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>

    <style name="TextHeadline" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>

    <style name="DropTargetButton" parent="DropTargetButtonBase">
        <item name="android:fontFamily">@font/space_mono_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Stock Launcher3 settings theme (same items as AOSP) with the Not a Thing font. -->
    <style name="HomeSettings.Theme" parent="@android:style/Theme.DeviceDefault.Settings">
        <item name="android:navigationBarColor">?android:colorPrimaryDark</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="preferenceTheme">@style/HomeSettings.PreferenceTheme</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>
</resources>
