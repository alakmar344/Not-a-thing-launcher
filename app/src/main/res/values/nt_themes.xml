<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher3 picks one of the AppTheme* styles (light/dark, wallpaper contrast); AOSP keeps them
    empty for derivative launchers to extend. Colours come from the generated Nothing palette in
    res-launcher3-theme.
-->
<resources>
    <style name="AppTheme" parent="@style/LauncherTheme">
        <!-- Not a Thing v10 surface on top of the stock theme. -->
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:colorAccent">@color/text_secondary</item>
        <item name="notificationDotColor">@color/nothing_red</item>
        <item name="popupNotificationDotColor">@color/nothing_red</item>
        <item name="allAppsScrimColor">@color/nothing_bg</item>
        <item name="allappsHeaderProtectionColor">@color/nothing_bg</item>
        <item name="popupColorPrimary">@color/surface_raised</item>
        <item name="popupColorSecondary">@color/surface_raised</item>
        <item name="popupColorTertiary">@color/hairline_strong</item>
        <item name="popupColorBackground">@color/surface_sheet</item>
        <item name="popupTextColor">@color/text_primary</item>
        <item name="folderBackgroundColor">@color/surface_sheet</item>
        <item name="folderPreviewColor">@color/surface_raised</item>
        <item name="folderIconBorderColor">@color/hairline_strong</item>
        <item name="folderTextColor">@color/text_primary</item>
        <item name="folderHintTextColor">@color/text_tertiary</item>
        <item name="folderPaginationColor">@color/text_primary</item>
    </style>

    <style name="AppTheme.DarkMainColor" parent="@style/LauncherTheme.DarkMainColor">
        <!-- Not a Thing v10 surface on top of the stock theme. -->
        <item name="android:fontFamily">@font/space_grotesk</item>
