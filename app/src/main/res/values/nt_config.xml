<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Not a Thing elements, offered in the stock widget picker. Launcher3 derives each custom
        widget's id from its POSITION in this list and stores it in the home screen database:
        only ever append new entries, never reorder or remove existing ones.
    -->
    <string-array name="custom_widget_providers" translatable="false">
        <item>com.nothinglauncher.widgets.ClockWidget</item>
        <item>com.nothinglauncher.widgets.BatteryCalendarWidget</item>
        <item>com.nothinglauncher.widgets.WeatherWidget</item>
        <item>com.nothinglauncher.widgets.MediaWidget</item>
        <item>com.nothinglauncher.widgets.QuickTogglesWidget</item>
        <item>com.nothinglauncher.widgets.FocusTimerWidget</item>
        <item>com.nothinglauncher.widgets.EssentialNoteWidget</item>
        <item>com.nothinglauncher.widgets.HabitMatrixWidget</item>
        <item>com.nothinglauncher.widgets.VitalsWidget</item>
        <item>com.nothinglauncher.widgets.CompassStepWidget</item>
        <item>com.nothinglauncher.widgets.SmartFolderWidget</item>
        <item>com.nothinglauncher.widgets.DeskBriefingWidget</item>
    </string-array>

    <!-- Every app icon and label is rendered by the Not a Thing icon factory. -->
    <string name="launcher_activity_logic_class" translatable="false">com.nothinglauncher.icons.NothingIconLogic</string>

    <!-- Hide the setup studio launcher icon inside our own drawer (visible in external launchers). -->
    <string-array name="filtered_components" translatable="false">
        <item>com.nothinglauncher/com.nothinglauncher.LauncherEntryActivity</item>
    </string-array>

    <dimen name="nt_tile_gap">12dp</dimen>
</resources>
