<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcuts on the app icon shown in the phone's app list. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:shortcutShortLabel="@string/settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.nothinglauncher.SettingsActivity"
            android:targetPackage="com.nothinglauncher" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_home"
        android:shortcutId="set_default_home"
        android:shortcutLongLabel="@string/shortcut_set_default_long"
        android:shortcutShortLabel="@string/shortcut_set_default">
        <intent
            android:action="com.nothinglauncher.action.SET_DEFAULT_HOME"
            android:targetClass="com.nothinglauncher.LauncherEntryActivity"
            android:targetPackage="com.nothinglauncher" />
    </shortcut>
</shortcuts>
