<?xml version="1.0" encoding="utf-8"?>
<!-- Element tile: a barely-there top-down sheen (v12) so tiles read as lit objects on the dot
     grid rather than flat cut-outs. A static gradient; no extra cost per frame. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/tile_sheen_bottom"
        android:startColor="@color/tile_sheen_top"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/hairline" />
    <corners android:radius="@dimen/tile_radius" />
</shape>
