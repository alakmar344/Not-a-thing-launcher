<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/entryScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nothing_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/entryColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <com.nothinglauncher.DotMatrixView
            android:id="@+id/entryHero"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            app:dmDotColor="@color/dot_on"
            app:dmDotScale="0.42"
            app:dmGravity="start"
            app:dmText="@string/nt_entry_title_v14" />

        <TextView
            android:id="@+id/entrySubtitle"
            style="@style/Text.Body.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nt_entry_subtitle" />

        <!-- Default Home Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_tile_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/entryHomeStatus"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/nothing_red" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nt_entry_home_title" />

            <TextView
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nt_entry_home_body" />

            <TextView
                android:id="@+id/entrySetHomeBtn"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_white"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/nt_entry_set_home"
                android:textColor="@color/pill_active_text" />
        </LinearLayout>

        <!-- Presets Section -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="@string/nt_presets_title" />

        <LinearLayout
            android:id="@+id/entryPresetsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Permissions & Capabilities -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="@string/nt_entry_capabilities" />

        <LinearLayout
            android:id="@+id/entryCapsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tile_dark"
            android:orientation="vertical"
            android:paddingHorizontal="16dp" />

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/entryOpenSettingsBtn"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="@string/nt_tile_settings"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/entryDeskBtn"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="@string/nt_desk_short"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/entryBackupBtn"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center"
                android:text="@string/nt_backup_export_short"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/entryImportBtn"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center"
                android:text="@string/nt_backup_import_short"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/entryGoHomeBtn"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_white"
            android:gravity="center"
            android:text="@string/nt_entry_launch_home"
            android:textColor="@color/pill_active_text" />

    </LinearLayout>
</ScrollView>
