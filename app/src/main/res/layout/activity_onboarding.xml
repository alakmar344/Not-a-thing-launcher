<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/onboardingScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/onboardingColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <!-- Editorial masthead -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/onboardingDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/dot_red" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:text="@string/onboarding_masthead"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/onboardingSkip"
                    style="@style/Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/skip"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/onboarding_kicker"
                android:textColor="@color/text_secondary" />

            <com.nothinglauncher.DotMatrixView
                android:id="@+id/onboardingWordmark"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                app:dmDotColor="@color/dot_on"
                app:dmDotScale="0.44"
                app:dmGravity="start"
                app:dmText="NOTHING" />

            <com.nothinglauncher.DotMatrixView
                android:id="@+id/onboardingWordmarkAccent"
                android:layout_width="wrap_content"
                android:layout_height="58dp"
                android:layout_marginTop="2dp"
                app:dmAccentColor="@color/nothing_red"
                app:dmDotColor="@color/dot_on"
                app:dmDotScale="0.44"
                app:dmGravity="start"
                app:dmText="BUT HOME" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/onboarding_title" />

            <TextView
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/onboarding_body" />

            <!-- Three concrete capabilities -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="34dp"
                            android:layout_height="wrap_content"
                            android:text="01"
                            android:textColor="@color/nothing_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_feature_1_title"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Text.Body.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/onboarding_feature_1_body"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/hairline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="34dp"
                            android:layout_height="wrap_content"
                            android:text="02"
                            android:textColor="@color/nothing_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_feature_2_title"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Text.Body.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/onboarding_feature_2_body"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/hairline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="34dp"
                            android:layout_height="wrap_content"
                            android:text="03"
                            android:textColor="@color/nothing_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_feature_3_title"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Text.Body.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/onboarding_feature_3_body"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Appearance quick-pick -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/onboarding_appearance" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_outline"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/onboardingThemeSystem"
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/theme_system"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/onboardingThemeDark"
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/theme_dark"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/onboardingThemeLight"
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/theme_light"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Home role card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_tile_dark"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/onboardingStatusDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:id="@+id/onboardingStatus"
                        style="@style/Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:text="@string/onboarding_home_not_default" />
                </LinearLayout>

                <TextView
                    android:id="@+id/onboardingDefaultAction"
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_pill_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/onboarding_set_default"
                    android:textColor="@color/pill_active_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/onboardingContinue"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/onboarding_continue"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/onboarding_footer"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
