<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:padding="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />

        <com.nothinglauncher.DotMatrixView
            android:id="@+id/countdownTitle"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="16dp"
            app:dmDotColor="@color/dot_on"
            app:dmDotScale="0.42"
            app:dmGravity="start"
            app:dmText="EDIT COUNTDOWN" />

        <EditText
            android:id="@+id/countdownInput"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tile_dark"
            android:hint="@string/countdown_title_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters"
            android:maxLength="24"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:id="@+id/countdownDate"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tile_dark"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/countdown_set_date"
            android:textColor="@color/text_primary"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawableTint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/countdownClear"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/countdown_clear"
                android:textColor="@color/nothing_red" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/countdownSave"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_white"
                android:gravity="center"
                android:text="@string/quick_note_save"
                android:textColor="@color/nothing_black" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
