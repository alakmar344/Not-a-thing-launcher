<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />

        <com.nothinglauncher.DotMatrixView
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            app:dmDotColor="@color/dot_on"
            app:dmDotScale="0.42"
            app:dmText="CUSTOMIZE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileWallpaper"
                layout="@layout/item_sheet_tile"
                android:layout_width="0dp"
                android:layout_height="108dp"
                android:layout_weight="1" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <include
                android:id="@+id/tileWidgets"
                layout="@layout/item_sheet_tile"
                android:layout_width="0dp"
                android:layout_height="108dp"
                android:layout_weight="1" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <include
                android:id="@+id/tileSettings"
                layout="@layout/item_sheet_tile"
                android:layout_width="0dp"
                android:layout_height="108dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
