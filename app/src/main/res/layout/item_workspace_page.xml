<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fadingEdgeLength="24dp"
    android:overScrollMode="never"
    android:requiresFadingEdge="vertical"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="8dp">

        <!-- Nothing Bespoke Elements (Clock, Battery, Weather, Toggles, etc.) -->
        <LinearLayout
            android:id="@+id/elementsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Third-party App Widgets -->
        <LinearLayout
            android:id="@+id/widgetContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Max / Enlarged 2x2 App Tiles -->
        <LinearLayout
            android:id="@+id/enlargedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- App Folders -->
        <LinearLayout
            android:id="@+id/foldersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Pinned App Grid for this page -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="-6dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Empty page hint -->
        <LinearLayout
            android:id="@+id/homeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tile_gap"
            android:background="@drawable/bg_dashed"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_empty_title"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Text.Body.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/home_empty_body" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
