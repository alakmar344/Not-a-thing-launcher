<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fadingEdgeLength="24dp"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none">

    <FrameLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Unified Native Android Grid for Apps, Folders, 2x2 Max Apps, Bespoke Widgets & AppWidgets -->
        <com.nothinglauncher.CellLayout
            android:id="@+id/cellLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="12dp" />

        <!-- Empty page hint -->
        <LinearLayout
            android:id="@+id/homeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/tile_gap"
            android:background="@drawable/bg_dashed"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_empty_title"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Text.Body.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/home_empty_body" />
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
