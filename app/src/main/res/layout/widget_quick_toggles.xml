<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile_dark"
    android:clickable="true"
    android:contentDescription="@string/element_toggles"
    android:focusable="true"
    android:foreground="@drawable/fg_ripple_tile"
    android:orientation="vertical"
    android:padding="@dimen/tile_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/togglesDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_red" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/element_toggles" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Wi-Fi -->
        <LinearLayout
            android:id="@+id/toggleWifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_ripple_tile"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/wifiDisc"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:id="@+id/wifiIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/toggle_wifi"
                    android:src="@drawable/ic_wifi" />
            </FrameLayout>

            <TextView
                android:id="@+id/wifiLabel"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/toggle_wifi" />
        </LinearLayout>

        <!-- Bluetooth -->
        <LinearLayout
            android:id="@+id/toggleBt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_ripple_tile"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btDisc"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:id="@+id/btIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/toggle_bt"
                    android:src="@drawable/ic_bluetooth" />
            </FrameLayout>

            <TextView
                android:id="@+id/btLabel"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/toggle_bt" />
        </LinearLayout>

        <!-- Torch / Flashlight -->
        <LinearLayout
            android:id="@+id/toggleTorch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_ripple_tile"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/torchDisc"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:id="@+id/torchIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/toggle_torch"
                    android:src="@drawable/ic_flashlight" />
            </FrameLayout>

            <TextView
                android:id="@+id/torchLabel"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/toggle_torch" />
        </LinearLayout>

        <!-- Sound / Volume -->
        <LinearLayout
            android:id="@+id/toggleSound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_ripple_tile"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/soundDisc"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button">

                <ImageView
                    android:id="@+id/soundIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/toggle_sound"
                    android:src="@drawable/ic_volume" />
            </FrameLayout>

            <TextView
                android:id="@+id/soundLabel"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sound_normal" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
