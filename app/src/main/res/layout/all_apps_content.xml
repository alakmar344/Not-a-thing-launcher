<?xml version="1.0" encoding="utf-8"?>
<!-- Copy of Launcher3's all_apps_content.xml (all ids kept) plus the v10 drawer header. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Not a Thing: v10 "APPS 026" header above the stock search box. -->
    <com.nothinglauncher.drawer.DrawerHeader
        android:id="@+id/nt_drawer_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp">

        <com.nothinglauncher.DotMatrixView
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            app:dmDotColor="@color/dot_on"
            app:dmDotScale="0.42"
            app:dmText="APPS" />

        <TextView
            android:id="@+id/drawerCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/space_mono_regular"
            android:letterSpacing="0.1"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/drawerSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/nt_tile_settings"
            android:padding="12dp"
            android:src="@drawable/ic_tune"
            android:tint="@color/text_primary" />
    </com.nothinglauncher.drawer.DrawerHeader>


    <include
        layout="@layout/all_apps_bottom_sheet_background"
        android:visibility="gone" />

    <include
        layout="@layout/search_results_rv_layout"
        android:visibility="gone" />

    <include
        layout="@layout/all_apps_rv_layout"
        android:visibility="gone" />

    <com.android.launcher3.allapps.FloatingHeaderView
        android:id="@+id/all_apps_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:layout_below="@id/search_container_all_apps"
        android:paddingTop="@dimen/all_apps_header_top_padding"
        android:paddingBottom="@dimen/all_apps_header_bottom_padding"
        android:orientation="vertical" >

        <include layout="@layout/floating_header_content" />

        <include layout="@layout/all_apps_personal_work_tabs" />

    </com.android.launcher3.allapps.FloatingHeaderView>

    <include layout="@layout/all_apps_fast_scroller" />
</merge>