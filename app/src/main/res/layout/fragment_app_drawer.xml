<?xml version="1.0" encoding="utf-8"?>
<com.nothinglauncher.SwipeGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drawer_bg">

    <LinearLayout
        android:id="@+id/drawerColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Grab handle: a hint that the panel can be swiped away -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drag_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="14dp">

            <com.nothinglauncher.DotMatrixView
                android:id="@+id/drawerTitle"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                app:dmDotColor="@color/dot_on"
                app:dmDotScale="0.42"
                app:dmGravity="start"
                app:dmText="APPS" />

            <TextView
                android:id="@+id/appCount"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/text_tertiary" />

            <ImageView
                android:id="@+id/settingsButton"
                style="@style/Widget.Nothing.IconButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchField"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pill_height"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/page_margin"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/searchBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/space_grotesk"
                android:hint="@string/search_apps"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textCursorDrawable="@drawable/cursor_accent"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/clearSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/fg_ripple_oval"
                android:contentDescription="@string/clear_search"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadingEdgeLength="20dp"
                android:overScrollMode="never"
                android:paddingStart="10dp"
                android:paddingEnd="30dp"
                android:paddingBottom="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none" />

            <com.nothinglauncher.AlphabetScrollerView
                android:id="@+id/alphabetScroller"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/letterBubble"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="48dp"
                android:alpha="0"
                android:background="@drawable/bg_letter_bubble"
                android:elevation="8dp"
                android:padding="18dp">

                <com.nothinglauncher.DotMatrixView
                    android:id="@+id/letterBubbleText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:dmDotColor="@color/dot_on"
                    app:dmDotScale="0.42" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="56dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:visibility="gone">

                <com.nothinglauncher.DotMatrixView
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    app:dmDotColor="@color/text_tertiary"
                    app:dmDotScale="0.42"
                    app:dmText="NO MATCH" />

                <TextView
                    android:id="@+id/webSearchButton"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_pill_white"
                    android:drawablePadding="10dp"
                    android:ellipsize="end"
                    android:foreground="@drawable/fg_ripple_pill"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="20dp"
                    android:paddingEnd="22dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/ic_globe"
                    android:drawableTint="@color/ink" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</com.nothinglauncher.SwipeGestureLayout>
