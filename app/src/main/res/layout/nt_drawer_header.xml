<?xml version="1.0" encoding="utf-8"?>
<com.nothinglauncher.drawer.DrawerHeader xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.nothinglauncher.DotMatrixView
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            app:dmDotColor="@color/dot_on"
            app:dmDotScale="0.42"
            app:dmText="APPS" />

        <TextView
            android:id="@+id/drawerCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono_regular"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/drawerModeChip"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/drawer_mode_grid"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/drawerDesk"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/nt_desk_title"
            android:padding="8dp"
            android:src="@drawable/ic_timer"
            android:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/drawerVault"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/vault_title"
            android:padding="8dp"
            android:src="@drawable/ic_lock"
            android:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/drawerSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/nt_tile_settings"
            android:padding="8dp"
            android:src="@drawable/ic_tune"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/drawerRecentsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/drawerRecentsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</com.nothinglauncher.drawer.DrawerHeader>
