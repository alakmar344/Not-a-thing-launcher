<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile_dark"
    android:clickable="true"
    android:contentDescription="@string/clock_widget"
    android:focusable="true"
    android:foreground="@drawable/fg_ripple_tile"
    android:orientation="vertical"
    android:padding="@dimen/tile_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/liveDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_red" />

        <TextView
            android:id="@+id/clockLabel"
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/local_time" />

        <TextView
            android:id="@+id/clockMeridiem"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fg_ripple_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_primary"
            android:text="@string/format_24h" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="60dp"
        android:layout_marginTop="10dp">

        <com.nothinglauncher.DotMatrixClockView
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:dmDotColor="@color/dot_on"
            app:dmDotScale="0.4"
            app:dmGlow="true"
            app:dmOffColor="@color/dot_off"
            app:dmPanel="true"
            app:dmPanelPadRows="1" />

        <com.nothinglauncher.AnalogDotClockView
            android:id="@+id/clockAnalog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.nothinglauncher.DotMatrixView
            android:id="@+id/clockWord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:dmDotColor="@color/dot_on"
            app:dmDotScale="0.38"
            app:dmGlow="true"
            app:dmGravity="start"
            app:dmOffColor="@color/dot_off"
            app:dmPanel="true" />
    </FrameLayout>

    <com.nothinglauncher.SecondsTickerView
        android:id="@+id/secondsTicker"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/clockDate"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
