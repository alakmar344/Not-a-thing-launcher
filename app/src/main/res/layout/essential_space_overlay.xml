<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/essentialRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/essentialScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/essentialColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.nothinglauncher.DotMatrixView
                        android:id="@+id/essentialHeaderDots"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        app:dmDotColor="@color/dot_on"
                        app:dmDotScale="0.42"
                        app:dmGravity="start"
                        app:dmText="ESSENTIAL" />

                    <TextView
                        android:id="@+id/essentialGreeting"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/essential_subtitle" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/essentialCloseBtn"
                    style="@style/Widget.Nothing.IconButton"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Briefing Card: Clock + Weather + Next Alarm/Event -->
            <LinearLayout
                android:id="@+id/essentialBriefingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tile_dark"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/essentialBriefingDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:id="@+id/essentialBriefingLabel"
                        style="@style/Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/essential_briefing" />

                    <TextView
                        android:id="@+id/essentialWeatherPill"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/essentialBriefingHeadline"
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/essentialBriefingSub"
                    style="@style/Text.Body.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Hardware Switchboard -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/spaceTorchBtn"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/fg_ripple_tile"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/spaceTorchIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_flashlight"
                        android:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/spaceTorchLabel"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/toggle_torch" />
                </LinearLayout>

                <Space android:layout_width="8dp" android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/spaceFocusBtn"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/fg_ripple_tile"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/spaceFocusIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_focus"
                        android:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/spaceFocusLabel"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/toggle_focus" />
                </LinearLayout>

                <Space android:layout_width="8dp" android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/spaceCaffeineBtn"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/fg_ripple_tile"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/spaceCaffeineIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_caffeine"
                        android:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/spaceCaffeineLabel"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/toggle_caffeine" />
                </LinearLayout>

                <Space android:layout_width="8dp" android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/spaceSoundBtn"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/fg_ripple_tile"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/spaceSoundIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_volume"
                        android:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/spaceSoundLabel"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/toggle_sound" />
                </LinearLayout>
            </LinearLayout>

            <!-- Essential Note & Voice Memo Capture Card -->
            <LinearLayout
                android:id="@+id/spaceCaptureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tile_dark"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/spaceRecDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/essential_capture" />

                    <TextView
                        android:id="@+id/spaceVoiceBtn"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_pill_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/fg_ripple_pill"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/memo_record"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/spaceNoteBody"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fg_ripple_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/space_mono_regular"
                    android:lineSpacingExtra="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/note_empty_hint"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/spaceMemoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/spaceMemoPlay"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_pill_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_play"
                        android:tint="@color/pill_active_text" />

                    <TextView
                        android:id="@+id/spaceMemoLabel"
                        style="@style/Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:id="@+id/spaceMemoDelete"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/fg_ripple_oval"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_trash"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Focus Timer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tile_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/spaceTimerMode"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timer_label" />

                    <com.nothinglauncher.DotMatrixView
                        android:id="@+id/spaceTimerDots"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginTop="8dp"
                        app:dmDotColor="@color/dot_on"
                        app:dmDotScale="0.4"
                        app:dmGravity="start"
                        app:dmText="25:00" />
                </LinearLayout>

                <TextView
                    android:id="@+id/spaceTimerReset"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/fg_ripple_pill"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/timer_reset"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/spaceTimerToggle"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/fg_ripple_pill"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/timer_start"
                    android:textColor="@color/pill_active_text" />
            </LinearLayout>

            <!-- System Vitals & Digital Balance Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tile_dark"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vitals_label" />

                <TextView
                    android:id="@+id/spaceVitalsText"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/space_mono_regular"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
