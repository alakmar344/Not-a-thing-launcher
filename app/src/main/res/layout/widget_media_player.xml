<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile_dark"
    android:clickable="true"
    android:contentDescription="@string/element_media"
    android:focusable="true"
    android:foreground="@drawable/fg_ripple_tile"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/mediaDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_red" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/media_label"
            android:textColor="@color/text_secondary" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tune"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Track Title and Artist -->
    <TextView
        android:id="@+id/mediaTitle"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/space_mono_bold"
        android:text="@string/media_title_default"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/mediaArtist"
        style="@style/Text.Body.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/space_mono_regular"
        android:text="@string/media_artist_default"
        android:textSize="10sp" />

    <!-- Waveform Visualizer -->
    <com.nothinglauncher.MediaDotsView
        android:id="@+id/mediaVisualizer"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="10dp" />

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mediaPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/fg_ripple_oval"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mediaPlayPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_pill_white"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_pause"
            android:tint="@color/surface_dark" />

        <ImageView
            android:id="@+id/mediaNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/fg_ripple_oval"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
