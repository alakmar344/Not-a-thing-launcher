<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/maxAppRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tile_dark"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/fg_ripple_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/maxAppIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/maxAppLabel"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            style="@style/Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ENLARGED · 2×2"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <View
        android:id="@+id/maxAppDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/dot_red" />
</LinearLayout>
