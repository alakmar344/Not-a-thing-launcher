<?xml version="1.0" encoding="utf-8"?>
<com.nothinglauncher.SwipeGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Multi-page horizontal workspace -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/workspaceRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <!-- Minimalist Nothing dot page indicator -->
        <com.nothinglauncher.PageIndicatorView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp" />

        <!-- Persistent Dock & Search Pill -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="12dp">

            <com.nothinglauncher.DockView
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dock_height" />

            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pill_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/fg_ripple_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_secondary" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/search_hint_home"
                    android:textColor="@color/text_secondary" />

                <ImageView
                    android:id="@+id/drawerButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/open_drawer"
                    android:padding="11dp"
                    android:src="@drawable/ic_apps"
                    android:tint="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.nothinglauncher.SwipeGestureLayout>
