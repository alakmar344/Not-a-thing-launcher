<?xml version="1.0" encoding="utf-8"?>
<com.nothinglauncher.SwipeGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/page_margin"
                android:paddingBottom="8dp">

                <include
                    android:id="@+id/clockTile"
                    layout="@layout/widget_clock" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tile_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/batteryTile"
                        layout="@layout/widget_battery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/calendarTile"
                        layout="@layout/widget_calendar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widgetContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="-6dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:id="@+id/homeEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tile_gap"
                    android:background="@drawable/bg_dashed"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="26dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="26dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_empty_title"
                        android:textColor="@color/text_primary" />

                    <TextView
                        style="@style/Text.Body.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/home_empty_body" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="12dp">

            <com.nothinglauncher.DockView
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dock_height" />

            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pill_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/fg_ripple_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_secondary" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/search_hint_home"
                    android:textColor="@color/text_secondary" />

                <ImageView
                    android:id="@+id/drawerButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/open_drawer"
                    android:padding="11dp"
                    android:src="@drawable/ic_apps"
                    android:tint="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.nothinglauncher.SwipeGestureLayout>
