<?xml version="1.0" encoding="utf-8"?>
<!-- Android System StandBy Screensaver (DreamService) layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dreamRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nothing_black">

    <LinearLayout
        android:id="@+id/dreamCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dreamAccentDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_red" />

            <TextView
                android:id="@+id/dreamDate"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/dreamBatteryPill"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/dreamFacePill"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_pill_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_primary"
                android:textSize="9.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <com.nothinglauncher.DotMatrixClockView
                android:id="@+id/dreamClock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:dmDotColor="@color/dot_on"
                app:dmDotScale="0.41"
                app:dmGlow="true"
                app:dmOffColor="@color/dot_off"
                app:dmPanel="true"
                app:dmPanelPadRows="1" />

            <com.nothinglauncher.AnalogDotClockView
                android:id="@+id/dreamClockAnalog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.nothinglauncher.DotMatrixView
                android:id="@+id/dreamClockWord"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:dmDotColor="@color/dot_on"
                app:dmDotScale="0.38"
                app:dmGlow="true"
                app:dmGravity="center"
                app:dmOffColor="@color/dot_off"
                app:dmPanel="true" />
        </FrameLayout>

        <com.nothinglauncher.SecondsTickerView
            android:id="@+id/dreamSeconds"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tile_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dreamWeatherText"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/space_mono_bold"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/dreamDigestText"
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dreamOpenDeskBtn"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_pill_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/nt_desk_launch"
                android:textColor="@color/pill_active_text"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
