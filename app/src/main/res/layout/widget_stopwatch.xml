<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile_dark"
    android:clickable="true"
    android:contentDescription="@string/element_stopwatch"
    android:focusable="true"
    android:foreground="@drawable/fg_ripple_tile"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/stopwatchDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_red" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/stopwatch_label"
            android:textColor="@color/text_secondary" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stopwatch"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Stopwatch Display -->
    <com.nothinglauncher.StopwatchDotsView
        android:id="@+id/stopwatchView"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReset"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_outline"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/stopwatch_reset"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/btnStartStop"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_pill_white"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="22dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:paddingBottom="8dp"
            android:text="@string/stopwatch_start"
            android:textColor="@color/surface_dark" />
    </LinearLayout>
</LinearLayout>
