<?xml version="1.0" encoding="utf-8"?>
<!--
    Not a Thing launcher: stock AOSP Launcher3 (see :launcher3, merged automatically) with the
    Not a Thing design layered on top. Only the home activity is declared here, exactly as
    Launcher3's AndroidManifest.xml asks derivative launchers to do.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Weather element (Open-Meteo, no key) and its automatic city lookup. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
    </queries>

    <application
        android:name="com.nothinglauncher.NothingApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/derived_app_name"
        android:theme="@style/AppTheme"
        tools:replace="android:name,android:icon,android:label">

        <activity
            android:name="com.nothinglauncher.home.NothingLauncher"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.SHOW_WORK_APPS" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
            <meta-data
                android:name="com.android.launcher3.grid.control"
                android:value="${applicationId}.grid_control" />
        </activity>

        <!-- Plain date & time widget; also keeps the widget provider list non-empty, which
             Launcher3 needs to register the in-process Not a Thing elements. -->
        <receiver
            android:name="com.nothinglauncher.widgets.DateTimeWidgetProvider"
            android:exported="false"
            android:label="@string/nt_widget_date_time">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nt_date_time_widget" />
        </receiver>

        <!-- v10 settings screen; opened from the customize sheet, the drawer and Home settings.
             Predictive back is opted in explicitly so Android 14/15 get the same back-to-home
             animation Android 16+ gives every app targeting API 36 (it only uses AndroidX's
             OnBackPressedDispatcher, which supports it). -->
        <activity
            android:name="com.nothinglauncher.settings.NothingSettingsActivity"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:exported="true"
            android:label="@string/settings_button_text"
            android:theme="@style/Theme.NothingLauncher.Settings">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Stock settings (notification dots etc.) open from Settings › Advanced home settings;
             they no longer claim APPLICATION_PREFERENCES, so "Home settings" opens the v10 screen. -->
        <activity
            android:name="com.android.launcher3.settings.SettingsActivity"
            tools:node="replace"
            android:exported="false"
            android:label="@string/settings_button_text"
            android:theme="@style/HomeSettings.Theme" />
        <activity
            android:name="com.nothinglauncher.LauncherEntryActivity"
            android:exported="true"
            android:label="@string/nt_entry_label"
            android:theme="@style/Theme.NothingLauncher.Entry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.nothinglauncher.DeskHudActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/nt_desk_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.NothingLauncher.Desk" />

        <activity
            android:name="com.nothinglauncher.drawer.VaultAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="com.nothinglauncher.NothingLockAccessibilityService"
            android:exported="false"
            android:label="@string/derived_app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nt_accessibility_service" />
        </service>

        <service
            android:name="com.nothinglauncher.NothingDreamService"
            android:exported="true"
            android:label="@string/nt_dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/nothing_dream_info" />
        </service>

    </application>
</manifest>
